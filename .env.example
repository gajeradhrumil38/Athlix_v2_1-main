NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── FatSecret Platform API ─────────────────────────────────────────────────
# Stored as Supabase Edge Function secrets (never in the browser).
# Set via: supabase secrets set FATSECRET_CONSUMER_KEY=xxx FATSECRET_CONSUMER_SECRET=yyy
# Get your credentials at: https://platform.fatsecret.com/api/Default.aspx?screen=api
FATSECRET_CONSUMER_KEY=ff9f589ace71429fb112566d6ffb7c9e
FATSECRET_CONSUMER_SECRET=1a3b992d542945dc8ab17ffa66090787
# Note: foods.recognize_v2 (image recognition) requires a FatSecret Premier plan.
# foods.search (text search) works on the free plan.

# ── AI Coach: Groq (primary provider) ──────────────────────────────────────
# Shared Groq key used server-side for the AI coach — far larger free daily
# quota than Gemini, so the coach stops hitting rate limits. Get one (free, no
# card) at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key
# Model ladder — tries GROQ_MODEL first, drops to GROQ_FALLBACK_MODEL on a
# rate-limit (429) or 5xx, so you get the best model when there's TPM headroom
# and never hit the wall. Defaults below. On a paid Groq tier, set
# GROQ_MODEL=openai/gpt-oss-120b for top quality.
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Build-time flag for the Vite SPA so the coach is usable WITHOUT a personal
# Gemini key (since Groq serves it). Set to 1 whenever GROQ_API_KEY is set.
VITE_GROQ_ENABLED=1
# Gemini stays as an automatic fallback; users can still add a personal Gemini
# key in Settings (also required for the image-based food scanner).
